# Backend API URL — REQUIRED
# Production (Vercel): Set this in Vercel Dashboard → Settings → Environment Variables
#   Example: NEXT_PUBLIC_API_URL=https://your-app.onrender.com
# Local development: Set in .env.local
#   Example: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=https://your-render-backend.onrender.com
